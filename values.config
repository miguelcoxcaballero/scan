# ============================================================================
# Scanner Pro - User Configuration
# ============================================================================
# All values range from 0 to 100 (similar to standard photo editors)
# Default value: 50 (neutral/normal) unless otherwise noted
# Changes take effect after reloading the page
# ============================================================================

# --- BASIC ADJUSTMENTS ---

# Brightness: Overall image brightness (affects shadow/highlight thresholds)
# Lower = darker shadows preserved, Higher = brighter overall with lifted shadows
# 0 = very dark (deep blacks), 50 = normal, 100 = very bright (lifted shadows)
brightness = 50

# Contrast: Difference between light and dark areas
# Lower = flatter image, Higher = more dramatic light/dark separation
# 0 = flat/low contrast, 50 = normal, 100 = high contrast
contrast = 50

# Saturation: Overall color intensity (inverse of desaturation strength)
# Lower = more grayscale/neutral, Higher = more vibrant colors
# 0 = heavily desaturated (nearly grayscale), 50 = normal, 100 = highly saturated
saturation = 50

# Hue: Color tone shift (affects yellow calibration target)
# Lower = cooler tones (shift toward blue), Higher = warmer tones (shift toward orange)
# 0 = cool tones, 50 = neutral, 100 = warm tones
hue = 50

# --- COLOR CHANNEL ADJUSTMENTS ---
# Note: These affect how the scanner DETECTS and PROCESSES each color
# Adjustments are subtle to prevent color confusion (e.g., red/blue mix-up)

# Red: Red detection sensitivity
# Lower = less aggressive red desaturation, Higher = more red preserved
# 0 = desaturate reds heavily, 50 = normal, 100 = preserve reds strongly
red = 50

# Green: Green detection sensitivity
# Lower = less green processing, Higher = more green channel boost
# 0 = reduce green, 50 = normal, 100 = enhance green
green = 50

# Blue: Blue detection sensitivity
# Lower = less aggressive blue detection, Higher = stronger blue detection
# 0 = minimal blue processing, 50 = normal, 100 = strong blue enhancement
# WARNING: High values may cause red/blue confusion
blue = 50

# Yellow: Yellow tone detection (for stencil and paper)
# Lower = looser yellow detection, Higher = stricter yellow detection
# 0 = detect less yellow, 50 = normal, 100 = detect more yellow
yellow = 50

# --- TONE ADJUSTMENTS ---

# White Point: How aggressively near-white pixels become pure white
# Lower = preserve subtle gray tones, Higher = force more pixels to pure white
# 0 = minimal white clipping, 50 = moderate (default), 100 = aggressive whitening
# Tip: Increase for scanned documents with gray/cream paper to make them whiter
white = 50

# Black Point: Shadow and dark area processing
# Lower = preserve gray shadows, Higher = push shadows toward pure black
# 0 = minimal black adjustment, 50 = moderate, 100 = deeper blacks
# Note: Currently has subtle effect, mainly affects shadow threshold detection
black = 50

# --- NORMALIZATION TARGETS ---

# Contrast Target (used by the contrast normalization step)
# Lower = flatter/softer, Higher = punchier
# 0 = very low contrast, 50 = normal, 100 = high contrast
contrast_target = 50

# Exposure Target (used by the exposure normalization step)
# Lower = darker output, Higher = brighter output
# 0 = darker, 50 = normal, 100 = bright
exposure_target = 50

# --- QUALITY ADJUSTMENTS ---

# Noise Reduction: Reduce grain and noise in the image
# Lower = preserve fine texture, Higher = smoother result
# 0 = no smoothing, 30 = slight smoothing (default), 100 = maximum smoothing
# Note: Currently affects preprocessing stage
noise = 30

# Definition: Edge sharpness and detail clarity (also affects margin restoration)
# Lower = softer edges, Higher = sharper details
# 0 = very soft (0.95x scale), 50 = normal (1.005x scale), 100 = very sharp (1.06x scale)
# Tip: Increase for text documents, decrease for photos with fine gradients
definition = 50
